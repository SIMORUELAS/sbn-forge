'use strict';
const repository = require('./{{names.moduleName}}.repository');
function notFound(id){const e=new Error('Registro no encontrado.');e.statusCode=404;e.code='{{names.permissionPrefix}}_NOT_FOUND';e.details={id};return e;}
async function list(query,context){return repository.list(query,context);}
async function getById(id,context){const row=await repository.getById(id,context);if(!row)throw notFound(id);return row;}
async function create(input,context){return repository.create(input,context);}
function versionConflict(id){const e=new Error('El registro fue modificado por otra operación.');e.statusCode=409;e.code='{{names.permissionPrefix}}_VERSION_CONFLICT';e.details={id};return e;}
async function update(id,input,context){
  const row=await repository.update(id,input,context);
  if(row)return row;
  const existing=await repository.getById(id,context);
  if(!existing)throw notFound(id);
  throw versionConflict(id);
}
async function remove(id,context){const ok=await repository.remove(id,context);if(!ok)throw notFound(id);}
module.exports={list,getById,create,update,remove};
