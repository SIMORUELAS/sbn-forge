'use strict';

const service =
  require(
    './{{names.moduleName}}.service'
  );

function requestContext(
  request
) {
  return {
    userId:
      request.user?.id,

    organizationId:
      request.user
        ?.organization_id,

    source:
      request.headers[
        'x-client-source'
      ] || 'api'
  };
}

function handleDatabaseError(
  error,
  reply
) {
  if (
    error?.code ===
    '23505'
  ) {
    return reply
      .code(409)
      .send({
        error:
          'CONFLICT',

        code:
          'UNIQUE_VIOLATION',

        message:
          error.detail ||
          'Ya existe un registro con esos datos.',

        constraint:
          error.constraint ||
          null
      });
  }

  throw error;
}

async function list(
  request,
  reply
) {
  const result =
    await service.list(
      request.query,
      requestContext(
        request
      )
    );

  return reply.send(
    result
  );
}

async function getById(
  request,
  reply
) {
  const result =
    await service.getById(
      {{#if primaryKeyInfo.isComposite}}request.params{{else}}request.params.id{{/if}},
      requestContext(
        request
      )
    );

  return reply.send(
    result
  );
}

async function create(
  request,
  reply
) {
  try {
    const result =
      await service.create(
        request.body,
        requestContext(
          request
        )
      );

    return reply
      .code(201)
      .send(
        result
      );
  } catch (error) {
    return handleDatabaseError(
      error,
      reply
    );
  }
}

async function update(
  request,
  reply
) {
  try {
    const result =
      await service.update(
        {{#if primaryKeyInfo.isComposite}}request.params{{else}}request.params.id{{/if}},
        request.body,
        requestContext(
          request
        )
      );

    return reply.send(
      result
    );
  } catch (error) {
    return handleDatabaseError(
      error,
      reply
    );
  }
}

async function remove(
  request,
  reply
) {
  await service.remove(
    {{#if primaryKeyInfo.isComposite}}request.params{{else}}request.params.id{{/if}},
    requestContext(
      request
    )
  );

  return reply
    .code(204)
    .send();
}

module.exports = {
  list,
  getById,
  create,
  update,
  remove
};