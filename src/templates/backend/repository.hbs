'use strict';

const TABLE_METADATA =
  Object.freeze({
    schema: '{{schema}}',
    table: '{{table}}',
    primaryKey: '{{primaryKeyInfo.columns.[0].name}}',
    primaryKeyColumns: Object.freeze([
{{#each primaryKeyInfo.columns}}
      '{{name}}'{{#unless @last}},{{/unless}}
{{/each}}
    ])
  });

const QUALIFIED_TABLE =
  `${TABLE_METADATA.schema}.${TABLE_METADATA.table}`;

const WRITABLE_COLUMNS =
  Object.freeze([
{{#each writableColumns}}
    '{{name}}'{{#unless @last}},{{/unless}}
{{/each}}
  ]);

const SORTABLE_COLUMNS =
  Object.freeze([
{{#each columns}}
    '{{name}}'{{#unless @last}},{{/unless}}
{{/each}}
  ]);

let db;

function configure(database) {
  if (
    !database ||
    typeof database.query !== 'function'
  ) {
    throw new TypeError(
      'El repository requiere un adaptador ' +
      'de base de datos con query().'
    );
  }

  db = database;
}

function connection() {
  if (!db) {
    throw new Error(
      'Repository no configurado. ' +
      'Ejecute configure(database).'
    );
  }

  return db;
}

function pickWritable(input) {
  return Object.fromEntries(
    Object.entries(input || {})
      .filter(
        ([key]) =>
          WRITABLE_COLUMNS.includes(key)
      )
  );
}

function safeSort(value) {
  return SORTABLE_COLUMNS.includes(value)
    ? value
    : TABLE_METADATA.primaryKeyColumns[0];
}

async function list(query = {}) {
  const limit =
    Math.min(
      Math.max(
        Number(query.limit) || 25,
        1
      ),
      100
    );

  const offset =
    Math.max(
      Number(query.offset) || 0,
      0
    );

  const sort =
    safeSort(query.sort);

  const direction =
    String(query.direction).toLowerCase() ===
      'asc'
      ? 'ASC'
      : 'DESC';

  const where = [];
  const values = [];

  {{#if capabilities.softDelete}}
  if (!query.include_deleted) {
    where.push(
      'deleted_at IS NULL'
    );
  }
  {{/if}}

  {{#each listFilters}}
  if (
    query.{{name}} !== undefined &&
    query.{{name}} !== null
  ) {
    values.push(
      query.{{name}}
    );

    where.push(
      '{{name}} = $' +
        values.length
    );
  }
  {{/each}}

  const whereClause =
    where.length > 0
      ? `WHERE ${where.join(' AND ')}`
      : '';

  const limitParameter =
    values.length + 1;

  const offsetParameter =
    values.length + 2;

  values.push(
    limit,
    offset
  );

  const sql = `
    SELECT *
    FROM ${QUALIFIED_TABLE}
    ${whereClause}
    ORDER BY ${sort} ${direction}
    LIMIT $${limitParameter}
    OFFSET $${offsetParameter}
  `;

  const result =
    await connection().query(
      sql,
      values
    );

  return {
    data: result.rows,
    meta: {
      limit,
      offset,
      count: result.rowCount
    }
  };
}

async function getById(id) {
  const keyValues =
    TABLE_METADATA.primaryKeyColumns.map(
      column =>
        TABLE_METADATA.primaryKeyColumns.length === 1
          ? id
          : id?.[column]
    );

  const keyWhere =
    TABLE_METADATA.primaryKeyColumns
      .map(
        (column, index) =>
          `${column} = $${index + 1}`
      )
      .join(' AND ');

  const sql = `
    SELECT *
    FROM ${QUALIFIED_TABLE}
    WHERE ${keyWhere}
    {{#if capabilities.softDelete}}AND deleted_at IS NULL{{/if}}
    LIMIT 1
  `;

  const result =
    await connection().query(
      sql,
      keyValues
    );

  return result.rows[0] || null;
}
async function create(
  input,
  context = {}
) {
  const data =
    pickWritable(input);

  {{#each primaryKeyInfo.columns}}
  {{#unless generated}}
  if (Object.prototype.hasOwnProperty.call(input, '{{name}}')) {
    data.{{name}} = input.{{name}};
  }
  {{/unless}}
  {{/each}}


  {{#if columnMap.created_by}}
  data.created_by =
    context.userId || null;
  {{/if}}

  {{#if columnMap.created_from}}
  data.created_from =
    context.source || 'api';
  {{/if}}

  const keys =
    Object.keys(data);

  const params =
    keys
      .map(
        (_, index) =>
          `$${index + 1}`
      )
      .join(', ');

  const sql = `
    INSERT INTO ${QUALIFIED_TABLE}
    ${keys.length > 0
      ? `(${keys.join(', ')}) VALUES (${params})`
      : 'DEFAULT VALUES'}
    {{#if capabilities.softDelete}}
    {{#unless primaryKeyInfo.columns.[0].generated}}
    ON CONFLICT ({{#each primaryKeyInfo.columns}}{{name}}{{#unless @last}}, {{/unless}}{{/each}})
    DO UPDATE SET
      deleted_at = NULL{{#if columnMap.deleted_by}},
      deleted_by = NULL{{/if}}{{#if columnMap.updated_at}},
      updated_at = CURRENT_TIMESTAMP{{/if}}{{#if columnMap.updated_by}}{{#if columnMap.created_by}},
      updated_by = EXCLUDED.created_by{{/if}}{{/if}}{{#if columnMap.updated_from}},
      updated_from = {{#if columnMap.created_from}}EXCLUDED.created_from{{else}}'api'{{/if}}{{/if}}{{#if capabilities.optimisticLock}},
      version_no = {{database.schema}}.{{database.table}}.version_no + 1{{/if}}
    WHERE {{database.schema}}.{{database.table}}.deleted_at IS NOT NULL
    {{/unless}}
    {{/if}}
    RETURNING *
  `;

  const result =
    await connection().query(
      sql,
      keys.map(
        key => data[key]
      )
    );

  {{#if capabilities.softDelete}}
  {{#unless primaryKeyInfo.columns.[0].generated}}
  if (result.rows[0]) {
    return result.rows[0];
  }

  const key = Object.fromEntries(
    TABLE_METADATA.primaryKeyColumns.map(column => [column, data[column]])
  );
  return getById(
    TABLE_METADATA.primaryKeyColumns.length === 1
      ? key[TABLE_METADATA.primaryKeyColumns[0]]
      : key
  );
  {{else}}
  return result.rows[0];
  {{/unless}}
  {{else}}
  return result.rows[0];
  {{/if}}
}

async function update(
  id,
  input,
  context = {}
) {
  const data =
    pickWritable(input);

  {{#if columnMap.updated_by}}
  data.updated_by =
    context.userId || null;
  {{/if}}

  {{#if columnMap.updated_from}}
  data.updated_from =
    context.source || 'api';
  {{/if}}

  {{#if capabilities.optimisticLock}}
  const expectedVersion =
    input.expected_version_no;

  if (!Number.isInteger(expectedVersion)) {
    throw new Error(
      'expected_version_no es obligatorio.'
    );
  }

  data.version_no =
    expectedVersion + 1;
  {{/if}}

  const keys =
    Object.keys(data);

  if (keys.length === 0) {
    throw new Error(
      'No hay campos para actualizar.'
    );
  }

  const values =
    keys.map(
      key => data[key]
    );

  const keyValues =
    TABLE_METADATA.primaryKeyColumns.map(
      column =>
        TABLE_METADATA.primaryKeyColumns.length === 1
          ? id
          : id?.[column]
    );

  const keyWhere =
    TABLE_METADATA.primaryKeyColumns
      .map(
        (column, index) =>
          `${column} = $${values.length + index + 1}`
      )
      .join(' AND ');

  values.push(...keyValues);

  const setClause =
    keys
      .map(
        (key, index) =>
          `${key} = $${index + 1}`
      )
      .join(', ');

  let sql = `
    UPDATE ${QUALIFIED_TABLE}
    SET ${setClause}
    WHERE ${keyWhere}
  `;

  {{#if capabilities.optimisticLock}}
  values.push(
    input.expected_version_no
  );

  sql += `
    AND version_no = $${values.length}
  `;
  {{/if}}

  {{#if capabilities.softDelete}}
  sql += `
    AND deleted_at IS NULL
  `;
  {{/if}}

  sql += `
    RETURNING *
  `;

  const result =
    await connection().query(
      sql,
      values
    );

  return result.rows[0] || null;
}

async function remove(
  id,
  context = {}
) {
  const keyValues =
    TABLE_METADATA.primaryKeyColumns.map(
      column =>
        TABLE_METADATA.primaryKeyColumns.length === 1
          ? id
          : id?.[column]
    );

  const keyWhere =
    TABLE_METADATA.primaryKeyColumns
      .map(
        (column, index) =>
          `${column} = $${index + 1}`
      )
      .join(' AND ');

  {{#if capabilities.softDelete}}
  const values = [...keyValues];
  {{#if columnMap.deleted_by}}
  values.push(context.userId || null);
  {{/if}}

  const sql = `
    UPDATE ${QUALIFIED_TABLE}
    SET
      deleted_at = CURRENT_TIMESTAMP{{#if columnMap.deleted_by}},
      deleted_by = $${values.length}{{/if}}{{#if capabilities.optimisticLock}},
      version_no = version_no + 1{{/if}}
    WHERE ${keyWhere}
      AND deleted_at IS NULL
    RETURNING *
  `;
  {{else}}
  const values = [...keyValues];

  const sql = `
    DELETE FROM ${QUALIFIED_TABLE}
    WHERE ${keyWhere}
    RETURNING *
  `;
  {{/if}}

  const result =
    await connection().query(
      sql,
      values
    );

  return result.rowCount > 0;
}
module.exports = {
  configure,
  list,
  getById,
  create,
  update,
  remove,
  TABLE_METADATA,
  QUALIFIED_TABLE,
  WRITABLE_COLUMNS,
  SORTABLE_COLUMNS
};

