'use strict';

const controller =
  require(
    './{{names.moduleName}}.controller'
  );

const schemas =
  require(
    './{{names.moduleName}}.schema'
  );

const repository =
  require(
    './{{names.moduleName}}.repository'
  );

async function {{names.variablePlural}}Routes(
  fastify,
  options = {}
) {
  /*
   * Por defecto utiliza fastify.pg.
   *
   * También permite proporcionar:
   *
   * - options.databaseDecorator
   * - options.database
   *
   * Esto permite usar otro adaptador sin
   * modificar el módulo generado.
   */
  const databaseDecorator =
    options.databaseDecorator ||
    'pg';

  const database =
    options.database ||
    fastify[databaseDecorator];

  if (
    !database ||
    typeof database.query !== 'function'
  ) {
    throw new Error(
      'No se encontró un adaptador de base ' +
      `de datos válido en fastify.${databaseDecorator}. ` +
      'Registre el plugin correspondiente o ' +
      'proporcione options.database.'
    );
  }

  repository.configure(
    database
  );

  const base =
    '{{names.routeBase}}';

  fastify.get(
    base,
    {
      schema: schemas.list
    },
    controller.list
  );

  fastify.get(
    `${base}/:id`,
    {
      schema: schemas.getById
    },
    controller.getById
  );

  fastify.post(
    base,
    {
      schema: schemas.create
    },
    controller.create
  );

  fastify.patch(
    `${base}/:id`,
    {
      schema: schemas.update
    },
    controller.update
  );

  fastify.delete(
    `${base}/:id`,
    {
      schema: schemas.remove
    },
    controller.remove
  );
}

module.exports =
  {{names.variablePlural}}Routes;
