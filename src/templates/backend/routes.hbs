'use strict';

const controller =
  require(
    './{{names.moduleName}}.controller'
  );

const schemas =
  require(
    './{{names.moduleName}}.schema'
  );

const repository =
  require(
    './{{names.moduleName}}.repository'
  );

async function {{names.variablePlural}}Routes(
  fastify,
  options = {}
) {
  /*
   * Por defecto utiliza fastify.pg.
   *
   * También permite proporcionar:
   *
   * - options.databaseDecorator
   * - options.database
   *
   * Esto permite usar otro adaptador sin
   * modificar el módulo generado.
   */
  const databaseDecorator =
    options.databaseDecorator ||
    'pg';

  const database =
    options.database ||
    fastify[databaseDecorator];

  if (
    !database ||
    typeof database.query !== 'function'
  ) {
    throw new Error(
      'No se encontró un adaptador de base ' +
      `de datos válido en fastify.${databaseDecorator}. ` +
      'Registre el plugin correspondiente o ' +
      'proporcione options.database.'
    );
  }

  if (options.requireTenantIsolation === true) {
    throw new Error('TENANT_ISOLATION_NOT_CERTIFIED');
  }

  repository.configure(
    database
  );

{{#if security.requireJwt}}
  // Guard de autenticación por módulo: no depende de hooks globales.
  const requireAuth = async (request, reply) => {
    if (typeof request.jwtVerify !== 'function') {
      return reply.code(503).send({
        message: 'Autenticacion JWT no configurada.'
      });
    }
    await request.jwtVerify();
  };
  fastify.addHook('onRequest', requireAuth);
{{/if}}

  // Integración explícita con el host. Nunca inferir permisos desde headers.
  // Si se activa, el adaptador debe resolver permisos desde una fuente confiable.
  const authorizeOperation = options.authorizeOperation;
  const requireCrudPermissions = options.requireCrudPermissions === true;
  if (requireCrudPermissions && typeof authorizeOperation !== 'function') {
    throw new Error('Se requiere options.authorizeOperation para activar permisos CRUD.');
  }
  const permissionGuard = operation => async (request, reply) => {
    if (!requireCrudPermissions) return;
    if (!request.user || !request.user.id || !request.user.organization_id) {
      return reply.code(401).send({ code: 'AUTHENTICATION_REQUIRED' });
    }
    const permitted = await authorizeOperation({
      operation,
      userId: request.user.id,
      organizationId: request.user.organization_id,
      request
    });
    if (permitted !== true) {
      return reply.code(403).send({ code: 'PERMISSION_DENIED' });
    }
  };

  const base =
    '{{names.routeBase}}';

  fastify.get(
    base,
    {
      schema: schemas.list,
      preHandler: permissionGuard('list')
    },
    controller.list
  );

  fastify.get(
    `${base}{{#if primaryKeyInfo.isComposite}}{{primaryKeyInfo.routePath}}{{else}}/:id{{/if}}`,
    {
      schema: schemas.getById,
      preHandler: permissionGuard('read')
    },
    controller.getById
  );

  fastify.post(
    base,
    {
      schema: schemas.create,
      preHandler: permissionGuard('create')
    },
    controller.create
  );

  fastify.patch(
    `${base}{{#if primaryKeyInfo.isComposite}}{{primaryKeyInfo.routePath}}{{else}}/:id{{/if}}`,
    {
      schema: schemas.update,
      preHandler: permissionGuard('update')
    },
    controller.update
  );

  fastify.delete(
    `${base}{{#if primaryKeyInfo.isComposite}}{{primaryKeyInfo.routePath}}{{else}}/:id{{/if}}`,
    {
      schema: schemas.remove,
      preHandler: permissionGuard('delete')
    },
    controller.remove
  );
}

module.exports =
  {{names.variablePlural}}Routes;
