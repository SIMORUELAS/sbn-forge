'use strict';

const idParam = {
  type: 'object',
{{#if primaryKeyInfo.isComposite}}
  required: [{{#each primaryKeyInfo.columns}}'{{name}}'{{#unless @last}}, {{/unless}}{{/each}}],
  properties: {
{{#each primaryKeyInfo.columns}}
    {{name}}: {
      type: '{{jsonSchema.type}}'{{#if jsonSchema.format}},
      format: '{{jsonSchema.format}}'{{/if}}
    }{{#unless @last}},{{/unless}}
{{/each}}
  },
{{else}}
  required: ['id'],
  properties: {
    id: {
      type: '{{primaryKeyColumn.jsonSchema.type}}'{{#if primaryKeyColumn.jsonSchema.format}},
      format: '{{primaryKeyColumn.jsonSchema.format}}'{{/if}}
    }
  },
{{/if}}
  additionalProperties: false
};

const writableProperties = {
{{#each writableColumns}}
  {{name}}: {
    type: '{{jsonSchema.type}}'{{#if jsonSchema.format}},
    format: '{{jsonSchema.format}}'{{/if}}{{#if jsonSchema.maxLength}},
    maxLength: {{jsonSchema.maxLength}}{{/if}}{{#if jsonSchema.nullable}},
    nullable: true{{/if}}
  }{{#unless @last}},{{/unless}}
{{/each}}
};

const createPrimaryKeyProperties = {
{{#each primaryKeyInfo.columns}}
{{#unless generated}}
  {{name}}: {
    type: '{{jsonSchema.type}}'{{#if jsonSchema.format}},
    format: '{{jsonSchema.format}}'{{/if}}
  },
{{/unless}}
{{/each}}
};
const list = {
  tags: ['{{names.module}}'],
  querystring: {
    type: 'object',
    properties: {
      limit: {
        type: 'integer',
        minimum: 1,
        maximum: 100,
        default: 25
      },
      offset: {
        type: 'integer',
        minimum: 0,
        default: 0
      },
      sort: {
        type: 'string'
      },
      direction: {
        type: 'string',
        enum: ['asc', 'desc']
      }{{#if capabilities.softDelete}},
      include_deleted: {
        type: 'boolean',
        default: false
      }{{/if}}{{#each listFilters}},
      {{name}}: {
        type: '{{filterSchemaType}}'{{#if filterSchemaFormat}},
        format: '{{filterSchemaFormat}}'{{/if}}{{#if filterSchemaMaxLength}},
        maxLength: {{filterSchemaMaxLength}}{{/if}}
      }{{/each}}
    },
    additionalProperties: false
  }
};

const getById = {
  tags: ['{{names.module}}'],
  params: idParam
};

const create = {
  tags: ['{{names.module}}'],
  body: {
    type: 'object',
    properties: { ...writableProperties, ...createPrimaryKeyProperties },
    {{#if createRequiredColumns.length}}
    required: [
      {{#each createRequiredColumns}}
      '{{name}}'{{#unless @last}},{{/unless}}
      {{/each}}
    ],
    {{/if}}
    additionalProperties: false
  }
};

const update = {
  tags: ['{{names.module}}'],
  params: idParam,
  body: {
    type: 'object',
    properties: {
      ...writableProperties{{#if capabilities.optimisticLock}},
      expected_version_no: {
        type: 'integer',
        minimum: 1
      }{{/if}}
    },
    {{#if capabilities.optimisticLock}}
    required: ['expected_version_no'],
    {{/if}}
    additionalProperties: false
  }
};

const remove = {
  tags: ['{{names.module}}'],
  params: idParam
};

module.exports = {
  list,
  getById,
  create,
  update,
  remove
};
