'use strict';

const idParam = {
  type: 'object',
  required: ['id'],
  properties: {
    id: {
      type: 'integer',
      minimum: 1
    }
  },
  additionalProperties: false
};

const writableProperties = {
{{#each writableColumns}}
  {{name}}: {
    type: '{{jsonSchema.type}}'{{#if jsonSchema.format}},
    format: '{{jsonSchema.format}}'{{/if}}{{#if jsonSchema.maxLength}},
    maxLength: {{jsonSchema.maxLength}}{{/if}}
  }{{#unless @last}},{{/unless}}
{{/each}}
};

const list = {
  tags: ['{{names.module}}'],
  querystring: {
    type: 'object',
    properties: {
      limit: {
        type: 'integer',
        minimum: 1,
        maximum: 100,
        default: 25
      },
      offset: {
        type: 'integer',
        minimum: 0,
        default: 0
      },
      sort: {
        type: 'string'
      },
      direction: {
        type: 'string',
        enum: ['asc', 'desc']
      }{{#if capabilities.softDelete}},
      include_deleted: {
        type: 'boolean',
        default: false
      }{{/if}}
    },
    additionalProperties: false
  }
};

const getById = {
  tags: ['{{names.module}}'],
  params: idParam
};

const create = {
  tags: ['{{names.module}}'],
  body: {
    type: 'object',
    properties: writableProperties,
    {{#if createRequiredColumns.length}}
    required: [
      {{#each createRequiredColumns}}
      '{{name}}'{{#unless @last}},{{/unless}}
      {{/each}}
    ],
    {{/if}}
    additionalProperties: false
  }
};

const update = {
  tags: ['{{names.module}}'],
  params: idParam,
  body: {
    type: 'object',
    properties: {
      ...writableProperties{{#if capabilities.optimisticLock}},
      expected_version_no: {
        type: 'integer',
        minimum: 1
      }{{/if}}
    },
    {{#if capabilities.optimisticLock}}
    required: ['expected_version_no'],
    {{/if}}
    additionalProperties: false
  }
};

const remove = {
  tags: ['{{names.module}}'],
  params: idParam
};

module.exports = {
  list,
  getById,
  create,
  update,
  remove
};